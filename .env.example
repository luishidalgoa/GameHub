# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="file:./gamehub.db"

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate SESSION_SECRET with: openssl rand -base64 32
SESSION_SECRET="change_me_32_chars_minimum"
ADMIN_PASSWORD="change_me_strong_password"

# ── Client IP resolution ──────────────────────────────────────────────────────
# Set to true ONLY when a reverse proxy (Apache/nginx) sits in front. It makes the
# app trust that proxy's X-Real-IP / X-Forwarded-For. Without it those headers are
# ignored, because a client can send whatever it likes in them.
# When the app is reached directly on its own port (the Switch talking to
# :3001) there is no such header and the client IP is simply unknown.
# TRUST_PROXY="true"

# Extra networks treated as local, comma separated CIDRs. RFC-1918, loopback and
# IPv6 ULA/link-local are already trusted. Add your VPN subnet here if it isn't
# private — notably Tailscale, which uses the CGNAT range:
# TRUSTED_NETWORKS="100.64.0.0/10"

# ── Admin access ──────────────────────────────────────────────────────────────
# Optional IP allowlist for the /admin UI, comma separated IPs/CIDRs (v4 + v6).
# LEAVE IT EMPTY unless you really want it: ADMIN_PASSWORD + the session cookie
# is what protects the admin area. /admin/login is reachable from anywhere and
# every mutating API is gated on the session alone, so this filter stops nobody
# who has the password — it only locks you out when your own address isn't what
# it expects (IPv6, CGNAT, a changed public IP…). Use a VPN for a real perimeter.
# Requires TRUST_PROXY=true behind a proxy, otherwise no IP can be resolved and
# every admin request is denied. List your LAN explicitly if you enable it.
# ADMIN_IP_ALLOWLIST="192.168.1.0/24,10.8.0.0/24"

# Legacy single-address form of the above ("this IP OR any private network").
# PUBLIC_IP="your.public.ip.address"

# ── Public URL (no trailing slash) ───────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── S3 / MinIO storage (optional — can also be set in Admin → Settings) ─────────
# Internal endpoint used by the backend (Node.js / Docker network)
# S3_ENDPOINT_INTERNO="http://minio:9000"
# Public endpoint used by the browser to display images
# S3_ENDPOINT_PUBLICO="https://s3.yourdomain.com"
# S3_BUCKET_NAME="gamehub"
# S3_ACCESS_KEY="your_access_key"
# S3_SECRET_KEY="your_secret_key"
# S3_REGION="us-east-1"    # change if MinIO returns region mismatch (e.g. eu-oest-1)

# ── API keys (optional — can also be set in Admin → Settings) ─────────────────
# RAWG metadata enrichment (https://rawg.io/apidocs)
# RAWG_API_KEY=""

# YouTube trailer search (https://console.cloud.google.com → YouTube Data API v3)
# YOUTUBE_API_KEY=""

# SteamGridDB cover art (https://www.steamgriddb.com/profile/preferences/api)
# STEAMGRIDDB_API_KEY=""

# ── Metrics (Prometheus) ───────────────────────────────────────────────────────
# /api/metrics is LAN-only by default. Set a token to allow remote scraping
# (use Prometheus `bearer_token`). See docs/observability/metrics-grafana.md
# METRICS_TOKEN=""
