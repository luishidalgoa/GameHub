generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Platform {
  id               Int      @id @default(autoincrement())
  slug             String   @unique
  name             String
  scanPath         String
  extensions       String
  iconPath         String?
  scanMode         String   @default("flat")   // flat | folder | ports
  sortOrder        Int      @default(0)
  enabled          Boolean  @default(true)
  thumbnailWidth   Int      @default(200)
  thumbnailHeight  Int      @default(300)
  scanDlc          Boolean  @default(false)
  emulatorName     String?  // deprecated — kept as fallback, superseded by `emulators`
  emulatorUrl      String?  // deprecated — kept as fallback, superseded by `emulators`
  emulators        String?  // JSON: { windows?: {name,url}, android?: {name,url}, ios?: {name,url} }
  games            Game[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Game {
  id         Int      @id @default(autoincrement())

  filePath   String   @unique
  fileName   String
  fileSize   BigInt

  platformId Int
  platform   Platform @relation(fields: [platformId], references: [id])

  title       String
  sortTitle   String?
  region      String?
  releaseYear Int?
  genre       String?
  developer   String?
  publisher   String?

  coverPath       String?
  coverUrl        String?
  trailerUrl      String?
  screenshotPaths String?

  // Per-field provenance from the last metadata fetch: JSON
  // { cover?, info?, description?, screenshots? } → 'launchbox' | 'rawg' | 'steamgriddb'.
  // Powers the source badges in the game editor.
  metadataSources String?

  description String?
  customNotes String?

  // External links (community mods, translations, etc.) — JSON array of
  // { title, description, url }. Rendered with GitHub-aware styling on the UI.
  externalLinks String?

  // Unification key for games split across multiple scan directories.
  // For Switch: the base Application ID derived from Title IDs.
  // Fallback: normalized folder/file name. Games sharing (platformId, groupKey)
  // are merged into a single card.
  groupKey String?

  igdbId   Int?
  rawgId   Int?
  rawgSlug String?

  // Objective popularity metrics from RAWG (for per-platform recommendations).
  // Raw signals stored as-is so the score formula can be tuned without re-syncing.
  // popularityFetchedAt is the idempotency marker: a non-null value means we've
  // already fetched, so the 'popularity' batch mode skips it (unless redo).
  rawgAdded           Int?       // # users who own/added it — primary signal for retro
  rawgRating          Float?     // RAWG rating 0–5
  rawgRatingsCount    Int?       // confidence (vote count)
  rawgMetacritic      Int?       // 0–100, often NULL for retro titles
  // Unified 0–100 score so badge/filter/sort use ONE scale: metacritic when
  // present, else the user rating mapped ×20 (4.1★ → 82). Stored (not derived)
  // because the filter/sort run in SQL.
  rawgScore           Int?
  // Where rawgScore came from: 'rawg' | 'metacritic' | 'launchbox' | 'manual'.
  // Keeps provenance honest — a LaunchBox community rating must NOT be mislabeled
  // as a Metacritic critic score.
  scoreSource         String?
  popularityFetchedAt DateTime?

  isFavorite   Boolean   @default(false)
  isHidden     Boolean   @default(false)
  playCount    Int       @default(0)
  lastPlayedAt DateTime?

  sha256            String?

  lastSeenAt        DateTime @default(now())
  metadataFetchedAt DateTime?

  dlcs         GameDlc[]
  downloadLogs DownloadLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([platformId])
  @@index([title])
  @@index([isFavorite])
  @@index([lastSeenAt])
  @@index([platformId, groupKey])
  @@index([platformId, rawgAdded])
  @@index([platformId, rawgScore])
}

model GameDlc {
  id       Int    @id @default(autoincrement())
  gameId   Int
  game     Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  filePath String @unique
  fileName String
  fileSize BigInt
  title    String?
  type     String @default("dlc")   // "dlc" | "update" | "mod"

  @@index([gameId])
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model ScanLog {
  id                Int       @id @default(autoincrement())
  startedAt         DateTime  @default(now())
  finishedAt        DateTime?
  gamesFound        Int       @default(0)
  gamesAdded        Int       @default(0)
  gamesUpdated      Int       @default(0)
  gamesStale        Int       @default(0)
  errors            String?
  triggeredBy       String    @default("manual")
  platformBreakdown String?   // JSON: PlatformScanSummary[]
}

model RequestLog {
  id         Int      @id @default(autoincrement())
  ip         String
  path       String
  method     String   @default("GET")
  status     Int      @default(200)
  userAgent  String?
  device     String?
  browser    String?
  referer    String?
  bytes      Int      @default(0)
  durationMs Int?
  ts         DateTime @default(now())

  @@index([ts])
  @@index([ip])
  @@index([status])
  @@index([device])
}

model SearchLog {
  id      Int      @id @default(autoincrement())
  query   String
  ip      String
  results Int      @default(0)
  ts      DateTime @default(now())

  @@index([ts])
  @@index([query])
}

model IpCache {
  ip          String   @id
  country     String?
  countryCode String?
  city        String?
  isp         String?
  flagEmoji   String?
  cachedAt    DateTime @default(now())
}

model DownloadToken {
  token     String  @id
  gameId    Int
  dlcId     Int?
  status    String  @default("waiting") // waiting | ready | downloading | done | expired
  position  Int     @default(0)
  createdAt BigInt
  readyAt   BigInt?
  expiresAt BigInt?

  @@index([status])
}

model Donation {
  id         Int      @id @default(autoincrement())
  platform   String   // kofi | paypal | bmac | crypto | manual
  amount     Float
  currency   String   @default("EUR")
  note       String?
  fromName   String?
  receivedAt DateTime @default(now())
  source     String   @default("manual") // manual | webhook
  externalId String?  @unique            // ko-fi transaction ID (dedup)

  @@index([receivedAt])
  @@index([platform])
}

model DownloadLog {
  id         Int       @id @default(autoincrement())
  gameId     Int
  game       Game      @relation(fields: [gameId], references: [id])
  dlcId      Int?
  dlcType    String?                // "dlc" | "update" when dlcId is set
  ip         String
  device     String?
  browser    String?
  fileName   String
  fileSize   BigInt
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  completed  Boolean   @default(false)

  @@index([gameId])
  @@index([startedAt])
  @@index([ip])
}

// Background job state for long-running tasks (scan / auto-metadata). Persisted
// so the dashboard can show progress when you return, and so an interrupted job
// (e.g. server restart) can be auto-resumed from where it left off.
model Job {
  id        Int      @id @default(autoincrement())
  type      String                  // "scan" | "metadata"
  status    String   @default("running")  // running | done | failed | cancelled
  // JSON of the launch parameters, so a resumed job runs with the same options
  // (e.g. metadata: { mode, platformSlug, withCovers, withTrailers }).
  params    String?
  phase     String?                 // human phase label (e.g. "scanning" | "metadata")
  total     Int      @default(0)
  processed Int      @default(0)
  applied   Int      @default(0)
  skipped   Int      @default(0)
  failed    Int      @default(0)
  // Resume cursor: the highest Game.id already handled this run. On resume we
  // continue at id > cursorId so we don't reprocess everything.
  cursorId  Int?
  lastTitle String?                 // last game touched, for the "by X" hint
  message   String?                 // final summary or error reason
  startedAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  finishedAt DateTime?

  @@index([type, status])
  @@index([status])
}
