generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Platform {
  id               Int      @id @default(autoincrement())
  slug             String   @unique
  name             String
  scanPath         String
  extensions       String
  iconPath         String?
  scanMode         String   @default("flat")   // flat | folder | ports
  sortOrder        Int      @default(0)
  enabled          Boolean  @default(true)
  thumbnailWidth   Int      @default(200)
  thumbnailHeight  Int      @default(300)
  scanDlc          Boolean  @default(false)
  emulatorName     String?  // deprecated — kept as fallback, superseded by `emulators`
  emulatorUrl      String?  // deprecated — kept as fallback, superseded by `emulators`
  emulators        String?  // JSON: { windows?: {name,url}, android?: {name,url}, ios?: {name,url} }

  // Per-platform metadata provider overrides. NULL means "inherit the global
  // setting" — the point is that the best source depends on the console: the
  // libretro box-art archive is ideal for retro carts and has no Switch data at
  // all, while LaunchBox is thin on Japan-only releases. Values are validated
  // against the same option lists as the global matrix; anything unrecognised
  // falls back to the global choice. See lib/metadata/matrix.ts.
  providerCover       String?
  providerInfo        String?
  providerDescription String?
  providerScreenshots String?

  games            Game[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Game {
  id         Int      @id @default(autoincrement())

  filePath   String   @unique
  fileName   String
  fileSize   BigInt

  platformId Int
  platform   Platform @relation(fields: [platformId], references: [id])

  title       String
  sortTitle   String?
  region      String?
  // Languages parsed from the file name (No-Intro/GoodTools tags), stored as a
  // CSV of ISO-639-1 codes, e.g. "es,en,it". Null when none were detected.
  languages   String?
  releaseYear Int?
  // Texto tal como lo publica la fuente (nombre visible). La entidad canonica es
  // la fila de Company / Genre a la que apunta; ver docs/reference/database.md.
  genre       String?
  developer   String?
  publisher   String?
  developerCompanyId Int?
  publisherCompanyId Int?
  developerCompany   Company? @relation("developerCompany", fields: [developerCompanyId], references: [id], onDelete: SetNull)
  publisherCompany   Company? @relation("publisherCompany", fields: [publisherCompanyId], references: [id], onDelete: SetNull)
  genres      GameGenre[]

  coverPath       String?
  coverUrl        String?
  trailerUrl      String?
  screenshotPaths String?

  // Per-field provenance from the last metadata fetch: JSON
  // { cover?, info?, description?, screenshots? } → 'launchbox' | 'rawg' | 'steamgriddb'.
  // Powers the source badges in the game editor.
  metadataSources String?

  description String?
  customNotes String?

  // External links (community mods, translations, etc.) — JSON array of
  // { title, description, url }. Rendered with GitHub-aware styling on the UI.
  externalLinks String?

  // Unification key for games split across multiple scan directories.
  // For Switch: the base Application ID derived from Title IDs.
  // Fallback: normalized folder/file name. Games sharing (platformId, groupKey)
  // are merged into a single card.
  groupKey String?

  // Nintendo Title ID (16 hex) cuando el nombre del fichero no lo lleva.
  // Normalmente se deduce del nombre --"Juego [0100ABC000XXX000].nsp"-- pero
  // hay volcados que llegan sin el, y sin Title ID la tienda no puede cruzar
  // el juego con su titledb: la consola lo pinta sin caratula y no encuentra
  // sus DLC. Esto es el respaldo manual, editable desde el editor de juegos.
  titleId  String?

  rawgId   Int?
  rawgSlug String?
  launchboxId Int?

  // Objective popularity metrics from RAWG (for per-platform recommendations).
  // Raw signals stored as-is so the score formula can be tuned without re-syncing.
  // popularityFetchedAt is the idempotency marker: a non-null value means we've
  // already fetched, so the 'popularity' batch mode skips it (unless redo).
  rawgAdded           Int?       // # users who own/added it — primary signal for retro
  rawgRating          Float?     // RAWG rating 0–5
  rawgMetacritic      Int?       // 0–100, often NULL for retro titles
  // Unified 0–100 score so badge/filter/sort use ONE scale: metacritic when
  // present, else the user rating mapped ×20 (4.1★ → 82). Stored (not derived)
  // because the filter/sort run in SQL.
  rawgScore           Int?
  // Where rawgScore came from: 'rawg' | 'metacritic' | 'launchbox' | 'manual'.
  // Keeps provenance honest — a LaunchBox community rating must NOT be mislabeled
  // as a Metacritic critic score.
  scoreSource         String?
  popularityFetchedAt DateTime?

  isFavorite   Boolean   @default(false)
  // Chosen by the owner to be highlighted on the home page.
  isFeatured   Boolean   @default(false)
  isHidden     Boolean   @default(false)
  userHidden   Boolean   @default(false)
  missingSince DateTime?

  // Home/game-page art, resolved from LaunchBox by priority (Banner, Fanart -
  // Background, Square, Screenshot - Game Title). `themePalette` is a JSON array
  // of up to three "#rrggbb" colors taken from the backdrop; the page tints
  // itself with them. `artCheckedAt` marks a game as processed so a game with no
  // LaunchBox art is not searched again on every run.
  backdropPath String?
  backdropKind String?
  // 16:9 fanart for the wide tiles; null when the game has none (the tile falls
  // back to a screenshot). Shares the backdrop's file when that is the fanart.
  tilePath     String?
  logoPath     String?
  themePalette String?
  artCheckedAt DateTime?
  // Resultado de buscar arte: ok | no-art | no-match. Alimenta la lista de juegos
  // a completar a mano o con otra fuente.
  artStatus    String?
  images       GameImage[]

  sha256            String?

  lastSeenAt        DateTime @default(now())
  metadataFetchedAt DateTime?
  // Estado del ultimo intento de metadatos (#110): matched | no_match | provider_error.
  metadataStatus    String?
  metadataAttempts  Int       @default(0)
  metadataNextRetryAt DateTime?

  dlcs         GameDlc[]
  downloadLogs DownloadLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([platformId])
  @@index([title])
  @@index([isFavorite])
  @@index([lastSeenAt])
  @@index([platformId, groupKey])
  @@index([platformId, rawgAdded])
  @@index([platformId, rawgScore])
}

model GameDlc {
  id       Int    @id @default(autoincrement())
  gameId   Int
  game     Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  filePath String @unique
  fileName String
  fileSize BigInt
  title    String?
  type     String @default("dlc")   // "dlc" | "update" | "mod" | "region"

  // Igual que Game.titleId: respaldo manual para los ficheros cuyo nombre no
  // trae el Title ID. Sin el, la consola no sabe de que juego es este
  // complemento y lo acaba escondiendo.
  titleId  String?

  // For type == "region": the region/languages of this alternate edition,
  // parsed from its file name. Lets one game card expose every regional ROM as
  // a separately downloadable version. Null/ignored for dlc/update/mod rows.
  region    String?
  languages String?

  @@index([gameId])
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model ScanLog {
  id                Int       @id @default(autoincrement())
  startedAt         DateTime  @default(now())
  finishedAt        DateTime?
  gamesFound        Int       @default(0)
  gamesAdded        Int       @default(0)
  gamesUpdated      Int       @default(0)
  gamesStale        Int       @default(0)
  errors            String?
  triggeredBy       String    @default("manual")
  platformBreakdown String?   // JSON: PlatformScanSummary[]
}

model RequestLog {
  id         Int      @id @default(autoincrement())
  ip         String
  path       String
  method     String   @default("GET")
  status     Int      @default(200)
  userAgent  String?
  device     String?
  browser    String?
  bytes      Int      @default(0)
  durationMs Int?
  ts         DateTime @default(now())

  @@index([ts])
  @@index([ip])
  @@index([status])
  @@index([device])
  @@index([path])
}

model SearchLog {
  id      Int      @id @default(autoincrement())
  query   String
  ip      String
  results Int      @default(0)
  ts      DateTime @default(now())

  @@index([ts])
  @@index([query])
}

model IpCache {
  ip          String   @id
  country     String?
  countryCode String?
  city        String?
  isp         String?
  flagEmoji   String?
  cachedAt    DateTime @default(now())
}

model DownloadToken {
  token     String  @id
  gameId    Int
  dlcId     Int?
  status    String  @default("waiting") // waiting | ready | downloading | done | expired
  position  Int     @default(0)
  createdAt BigInt
  readyAt   BigInt?
  expiresAt BigInt?
  batchId   String?  // lote al que pertenece (POST /api/queue/bulk); null para descargas sueltas

  @@index([status])
  @@index([batchId])
}

/// Fallos que GameHubNX (Switch) comunica al servidor (#91). Se guardan 30 dias.
model ClientDiagnostic {
  id            Int      @id @default(autoincrement())
  createdAt     DateTime @default(now())
  clientVersion String?
  kind          String   // p. ej. "install", "download", "decode"
  message       String
  device        String?

  @@index([createdAt])
}

model Donation {
  id         Int      @id @default(autoincrement())
  platform   String   // kofi | paypal | bmac | crypto | manual
  amount     Float
  currency   String   @default("EUR")
  note       String?
  fromName   String?
  receivedAt DateTime @default(now())
  source     String   @default("manual") // manual | webhook
  externalId String?  @unique            // ko-fi transaction ID (dedup)

  @@index([receivedAt])
  @@index([platform])
}

model DownloadLog {
  id         Int       @id @default(autoincrement())
  gameId     Int
  game       Game      @relation(fields: [gameId], references: [id])
  dlcId      Int?
  dlcType    String?                // "dlc" | "update" when dlcId is set
  ip         String
  device     String?
  browser    String?
  // De donde viene la descarga: "gamehubnx" | "cyberfoil" | "tinfoil" | "browser"
  // | "other". Se deduce del User-Agent, salvo que el cliente se identifique el
  // mismo con la cabecera X-GameHub-Client, que es mas fiable que adivinar.
  client        String?
  clientVersion String?
  fileName   String
  fileSize   BigInt
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  completed  Boolean   @default(false)

  @@index([gameId])
  @@index([startedAt])
  @@index([ip])
  @@index([completed])
  @@index([client])
}

// Background job state for long-running tasks (scan / auto-metadata). Persisted
// so the dashboard can show progress when you return, and so an interrupted job
// (e.g. server restart) can be auto-resumed from where it left off.
// Editora o desarrolladora canonica: una fila por empresa, con la clave normalizada
// (publisherKey) que usa el ranking de editoras de la portada.
model Company {
  id            Int      @id @default(autoincrement())
  key           String   @unique
  name          String
  createdAt     DateTime @default(now())
  publishedGames Game[]  @relation("publisherCompany")
  developedGames Game[]  @relation("developerCompany")
}

model Genre {
  id        Int         @id @default(autoincrement())
  key       String      @unique
  name      String
  games     GameGenre[]
}

model GameGenre {
  gameId  Int
  genreId Int
  game    Game  @relation(fields: [gameId], references: [id], onDelete: Cascade)
  genre   Genre @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([gameId, genreId])
  @@index([genreId])
}

// Una imagen de un juego tal como la publica LaunchBox, en el tamaño original y
// categorizada. El repositorio entero se monta desde aqui.
model GameImage {
  id        Int      @id @default(autoincrement())
  gameId    Int
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  kind      String                // banner | fanart | square | clear-logo | box-front | box-back | box-3d | box-spine | box-front-reconstructed | cart-front | disc | screenshot-gameplay | screenshot-game-title | other
  region    String?
  width     Int?
  height    Int?
  s3Key     String                // repo/<plataforma>/<juego>/<tipo>-<hash>.webp
  sourceUrl String
  createdAt DateTime @default(now())

  @@unique([gameId, sourceUrl])
  @@index([gameId, kind])
}

model Job {
  id        Int      @id @default(autoincrement())
  type      String                  // "scan" | "metadata"
  status    String   @default("running")  // running | done | failed | cancelled
  // JSON of the launch parameters, so a resumed job runs with the same options
  // (e.g. metadata: { mode, platformSlug, withCovers, withTrailers }).
  params    String?
  phase     String?                 // human phase label (e.g. "scanning" | "metadata")
  total     Int      @default(0)
  processed Int      @default(0)
  applied   Int      @default(0)
  skipped   Int      @default(0)
  failed    Int      @default(0)
  // Resume cursor: the highest Game.id already handled this run. On resume we
  // continue at id > cursorId so we don't reprocess everything.
  cursorId  Int?
  lastTitle String?                 // last game touched, for the "by X" hint
  message   String?                 // final summary or error reason
  // Quien lo tiene: un worker reclama el job y renueva heartbeatAt mientras trabaja (#75).
  ownerId       String?
  heartbeatAt   DateTime?
  // Pedido de cancelacion: el worker lo mira entre lotes y termina con status cancelled.
  cancelRequested Boolean @default(false)
  // Job que lanza a este otro (p. ej. el autofill de metadatos tras un escaneo).
  parentId      Int?
  startedAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  finishedAt DateTime?

  @@index([type, status])
  @@index([status])
}
